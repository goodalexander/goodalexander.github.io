[Unit]
Description=Refresh the GoodAlexander Doom Index full research panel
After=network-online.target
Wants=network-online.target
OnFailure=goodalexander-doom-index-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/repos/navstrategies
EnvironmentFile=-%h/.config/navstrategies/credentials.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/repos/navstrategies/.venv/bin/python %h/repos/us_debt_research/refresh_doom_index.py --profile full
TimeoutStartSec=12h
